generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model FoundationMetadata {
  id            String   @id
  schemaVersion String
  initializedAt DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum NewsCategory {
  HIRING_UPDATE
  SCAM_WATCH
  GUIDE
  MIL_EXPLAINER
}

enum NewsSourceStatus {
  SYNTHETIC_PROTOTYPE
  SYNTHETIC_SOURCE_LIST
}

model NewsArticle {
  id                String           @id
  slug              String           @unique
  category          NewsCategory
  title             String
  dek               String
  eyebrow           String
  bodySections      String[]
  verificationSteps String[]
  sourceNotes       String[]
  sourceStatus      NewsSourceStatus
  sourceStatusLabel String
  readingMinutes    Int
  isFeatured        Boolean          @default(false)
  publishedAt       DateTime
  reviewedAt        DateTime
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([category, publishedAt])
  @@index([isFeatured, publishedAt])
}

enum AlertLocation {
  CAMBODIA
  VIETNAM
  REGIONAL
}

enum AlertCategory {
  IDENTITY_DOCUMENT
  OFF_PLATFORM_CONTACT
  LICENCE_CLAIM
  UPFRONT_PAYMENT
}

enum AlertModerationStatus {
  CORROBORATED_PATTERN
  OFFICIAL_SOURCE_MISMATCH
  REVIEWED_PATTERN
}

model CommunityAlert {
  id                    String                  @id
  title                 String
  location              AlertLocation
  locationLabel         String
  category              AlertCategory
  categoryLabel         String
  moderationStatus      AlertModerationStatus
  moderationStatusLabel String
  summary               String
  compatibleReportCount Int
  maskedIdentifiers     String[]
  observedEvidence      String[]
  unknownInformation    String[]
  verificationSteps     String[]
  sourceNotes           String[]
  firstReportedAt       DateTime
  reviewedAt            DateTime
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([location, reviewedAt])
  @@index([category, reviewedAt])
  @@index([moderationStatus, reviewedAt])
}

enum SupportCountry {
  CAMBODIA
  VIETNAM
}

enum SupportContactKind {
  EMERGENCY
  EMBASSY
  ORGANIZATION
}

enum SupportAccessMode {
  CELLULAR
  INTERNET
}

enum SupportDataStatus {
  REVIEWED_REFERENCE
  SYNTHETIC_SUMMARY
}

model SupportContact {
  id              String            @id
  country         SupportCountry
  countryLabel    String
  kind            SupportContactKind
  title           String
  description     String
  displayValue    String
  actionUri       String
  actionLabel     String
  accessMode      SupportAccessMode
  accessLabel     String
  dataStatus      SupportDataStatus
  dataStatusLabel String
  sourceOwner     String
  sourceUrl       String
  languages       String[]
  hours           String
  lastReviewedAt  DateTime
  nextReviewAt    DateTime
  sortOrder       Int
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([country, isActive, sortOrder])
  @@index([nextReviewAt, isActive])
}

enum RecruitmentReportStatus {
  RECEIVED
  UNDER_REVIEW
  MORE_EVIDENCE_NEEDED
  REVIEWED
  CLOSED
  INCLUDED_IN_ALERT
  WITHDRAWN
}

enum RecruitmentReportSubjectType {
  JOB_POST
  RECRUITER
  COMPANY
  AGENCY
}

enum RecruitmentReportIdentifierType {
  URL
  PHONE
  HANDLE
  PAYMENT_ACCOUNT
  CLAIMED_ENTITY
}

enum RecruitmentReportBehaviour {
  IDENTITY_DOCUMENT_REQUEST
  PAYMENT_REQUEST
  PRESSURE
  COMPANY_NOT_FOUND
  CONTRACT_VISA_MISMATCH
  TRAVEL_ACCOMMODATION_CONTROL
  IMPERSONATION
}

model RecruitmentReport {
  id                       String                            @id @default(uuid())
  publicId                 String                            @unique
  status                   RecruitmentReportStatus           @default(RECEIVED)
  subjectType              RecruitmentReportSubjectType
  identifierType           RecruitmentReportIdentifierType
  privateIdentifier        String
  normalizedIdentifierHash String?
  privateDescription       String
  publicRedactedIdentifier String?
  publicRedactedDescription String?
  behaviours               RecruitmentReportBehaviour[]
  allowPrivateMatching     Boolean
  allowRedactedPublicAlert Boolean
  shareWithNamedPartner    Boolean
  namedPartner             String?
  idempotencyKeyHash       String                            @unique
  submissionPayloadHash    String
  recoveryKeyHash          String
  recoveryKeyDeliveryCiphertext String?
  recoveryKeyDeliverUntil  DateTime?
  submittedAt              DateTime                          @default(now())
  createdAt                DateTime                          @default(now())
  updatedAt                DateTime                          @updatedAt

  @@index([status, submittedAt])
  @@index([normalizedIdentifierHash])
}
