NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/verify_before_you_go
# Add http://<LAN-IP>:8081 and http://<LAN-IP>:8082 for physical-device dev and static-preview testing.
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:19006
# Keep direct for local/test. Set to railway only when requests arrive through Railway's proxy.
CLIENT_IP_PROXY_MODE=direct
# Generate a unique value with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
REPORT_SECURITY_SECRET=Y3AxMS1sb2NhbC1leGFtcGxlLXNlY3VyZS1zZWNyZXQtdmFsdWU
LOCAL_STORAGE_DIR=.local-storage
LOG_LEVEL=debug
